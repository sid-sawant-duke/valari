      "id": "020852aa-065d-4232-aa93-9c642b2137a0",
      "name": "Map Accounts",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        500,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// Values starting with = + - @ would run as spreadsheet formulas, so they are stored as plain text.\nconst cell = (v) => { const s = String(v ?? ''); return /^[=+\\-@\\t\\r]/.test(s) ? \"'\" + s : s; };\nreturn $input.all().map((i) => ({ json: {\n  recorded_at: new Date().toISOString(),\n  contact_id: cell(i.json.contact_id),\n  full_name: cell(i.json.full_name),\n  old_company: cell(i.json.old_company),\n  new_company: cell(i.json.new_company),\n  new_company_domain: cell(i.json.new_company_domain),\n  new_title: cell(i.json.new_title),\n  new_email: cell(i.json.new_email),\n  summary: cell(i.json.task_body),\n} }));"
      },
      "id": "86960656-65d1-4c04-adde-5a023c7215f3",
      "name": "Move Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        640
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $('Config').first().json.sheet_id }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('Config').first().json.moves_tab }}"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "3d792a0d-9177-45a1-a2cc-4708c9021c15",
      "name": "Append Move",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.6,
      "position": [
        500,
        640
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const rows = $('Move Rows').all();\nreturn $input.all().map((i, n) => ({ json: { contact_id: rows[n] ? rows[n].json.contact_id : '', crm_record_id: i.json.error ? '' : 'Moves tab', crm_record_type: 'sheet row', crm_record_url: '', task_id: '', error: i.json.error ? String(i.json.error.message || i.json.error) : '' } }));"
      },
      "id": "77a9105f-f683-406c-a367-e96bae651fe4",
      "name": "Move Result",
